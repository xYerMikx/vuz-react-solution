{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["dotenv/config"],
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "diagnostics": false }]
  },
  "moduleNameMapper": {
    "^@/(.*)$": "<rootDir>/src/$1",
    "^@generated/(.*)$": "<rootDir>/generated/$1"
  },
  "testEnvironment": "node",
  "testTimeout": 30000
}
