# Used when the API and Prisma run on the host. Docker Compose reads the
# repository root .env instead, and builds its own DATABASE_URL from POSTGRES_*.
DATABASE_URL=postgresql://squad:squad@localhost:5433/squad
REDIS_URL=redis://localhost:6379
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Optional. Defaults to ../frontend/src/data/characters.json
CHARACTERS_JSON_PATH=
